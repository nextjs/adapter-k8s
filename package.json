{
  "name": "@next-community/adapter-k8s",
  "version": "0.0.0",
  "homepage": "https://github.com/nextjs/adapter-k8s#readme",
  "bugs": {
    "url": "https://github.com/nextjs/adapter-k8s/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextjs/adapter-k8s.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "adapter-k8s": "dist/cli.cjs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "build:adapter": "esbuild ./src/index.ts --bundle --format=esm --platform=node --outfile=./dist/index.js --external:next --external:@next/routing --external:minimatch",
    "build:pool-server": "esbuild ./src/pool-server/index.ts --bundle --format=cjs --platform=node --outfile=./dist/pool-server.cjs",
    "build:routing-service": "esbuild ./src/routing-service/index.ts --bundle --format=cjs --platform=node --outfile=./dist/routing-service.cjs --external:@next/routing",
    "build:cli": "esbuild ./src/cli/index.ts --bundle --format=cjs --platform=node --outfile=./dist/cli.cjs --banner:js='#!/usr/bin/env node' && chmod +x ./dist/cli.cjs",
    "build": "npm run build:clean && npm run build:types && npm run build:adapter && npm run build:pool-server && npm run build:routing-service && npm run build:cli",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@next/routing": "^16.2.0",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "next": "^16.2.0"
  },
  "engines": {
    "node": ">= 20.9.0"
  }
}
