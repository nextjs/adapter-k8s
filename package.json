{
  "name": "@next-community/adapter-k8s",
  "version": "0.0.0",
  "homepage": "https://github.com/nextjs/adapter-k8s#readme",
  "bugs": {
    "url": "https://github.com/nextjs/adapter-k8s/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextjs/adapter-k8s.git"
  },
  "bin": {
    "adapter-k8s": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "integration",
    "scripts",
    "skills"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e-local.sh",
    "test:e2e:live": "vitest run --config vitest.e2e-live.config.ts",
    "test:e2e:edge:live": "vitest run --config vitest.e2e-live.config.ts tests/e2e/live/edge.test.ts",
    "test:e2e:pages:live": "vitest run --config vitest.e2e-live.config.ts tests/e2e/live/pages.test.ts",
    "test:e2e:i18n-rewrite:live": "vitest run --config vitest.e2e-live.config.ts tests/e2e/live/i18n-rewrite.test.ts",
    "test:e2e:interception:live": "vitest run --config vitest.e2e-live.config.ts tests/e2e/live/interception.test.ts",
    "test:e2e:baseline:apphosting": "bash scripts/e2e-apphosting-baseline.sh",
    "test:e2e:baseline:firebase": "bash scripts/e2e-firebase-baseline.sh",
    "test:integration": "NEXT_TEST_DEPLOY_SCRIPT_PATH=scripts/e2e-integration-deploy.sh NEXT_TEST_CLEANUP_SCRIPT_PATH=scripts/e2e-integration-cleanup.sh bash scripts/e2e-local.sh",
    "build:clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "build:adapter": "esbuild ./src/index.ts --bundle --format=esm --platform=node --outfile=./dist/index.js --external:next --external:@next/routing",
    "build:pool-server": "esbuild ./src/pool-server/index.ts --bundle --format=cjs --platform=node --outfile=./dist/pool-server.cjs --external:@next/routing --external:sharp",
    "build:cache-handler": "esbuild ./src/pool-server/valkey-cache/cache-handler-entry.ts --bundle --format=cjs --platform=node --outfile=./dist/cache-handler.cjs --external:next",
    "build:protos": "buf generate && node ./clean_protos.cjs",
    "build:routing-service": "esbuild ./src/routing-service/index.ts --bundle --format=cjs --platform=node --outfile=./dist/routing-service.cjs --external:@next/routing",
    "build:cli": "esbuild ./src/cli/index.ts --bundle --format=cjs --platform=node --outfile=./dist/cli.cjs --banner:js='#!/usr/bin/env node' && chmod +x ./dist/cli.cjs",
    "build": "npm run build:clean && npm run build:types && npm run build:adapter && npm run build:pool-server && npm run build:cache-handler && npm run build:protos && npm run build:routing-service && npm run build:cli",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@next/routing": "16.3.0",
    "boxen": "^8.0.1",
    "minimatch": "^10.2.4",
    "redos-detector": "^6.1.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "ioredis": "^5.11.1",
    "oxfmt": "^0.42.0",
    "oxlint": "1.73.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "next": "^16.3.0"
  },
  "engines": {
    "node": ">= 20.9.0"
  }
}
