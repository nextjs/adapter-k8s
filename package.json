{
  "name": "@next-community/adapter-k8s",
  "version": "0.0.0",
  "homepage": "https://github.com/nextjs/adapter-k8s#readme",
  "bugs": {
    "url": "https://github.com/nextjs/adapter-k8s/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextjs/adapter-k8s.git"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "dist/index.cjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:clean": "rm -rf dist",
    "build": "npm run build:clean && esbuild ./src/index.ts --bundle --format=cjs --platform=node --outfile=./dist/index.cjs --external:next --external:@next/routing --external:minimatch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@next/routing": "^16.2.0",
    "minimatch": "^10.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "next": "^16.2.0"
  },
  "engines": {
    "node": ">= 20.9.0"
  }
}
